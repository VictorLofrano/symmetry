rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Profiles
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'skillLevel'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.skillLevel is int
        && request.resource.data.skillLevel >= 1
        && request.resource.data.skillLevel <= 5;
    }

    // Events
    match /events/{eventId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'organizerId', 'name', 'description', 'sport', 'startsAt',
             'venue', 'capacity', 'status', 'confirmedCount', 'createdAt'
           ])
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.venue is string
        && request.resource.data.venue.size() > 0
        && request.resource.data.venue.size() <= 100
        && request.resource.data.startsAt is timestamp
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 2
        && request.resource.data.capacity <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.confirmedCount == 0;

      allow update: if signedIn() && (
        // The organizer edits event details
        (resource.data.organizerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'description', 'sport', 'startsAt', 'venue', 'capacity', 'status']))
        ||
        // Any player changes the joined counter, by one step, within capacity
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmedCount'])
          && request.resource.data.confirmedCount >= 0
          && request.resource.data.confirmedCount <= resource.data.capacity
          && request.resource.data.confirmedCount - resource.data.confirmedCount <= 1
          && resource.data.confirmedCount - request.resource.data.confirmedCount <= 1)
      );

      allow delete: if signedIn() && resource.data.organizerId == request.auth.uid;

      // Who is coming
      match /attendees/{userId} {
        allow read: if signedIn();

        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['status', 'displayName', 'skillLevel', 'updatedAt'])
          && request.resource.data.status in ['confirmed', 'notGoing', 'awaiting'];

        // A player can remove their own status; the organizer can clear the roster
        allow delete: if signedIn() && (
          request.auth.uid == userId
          || get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid
        );
      }
    }
  }
}